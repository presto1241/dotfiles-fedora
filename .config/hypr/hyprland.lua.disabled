-----------------------
---- LOOK AND FEEL ----
-----------------------

-- Refer to https://wiki.hypr.land/Configuring/Basics/Variables/
hl.config({
    general = {
        gaps_in  = 5,
        gaps_out = 20,

        border_size = 2,

        col = {
            active_border   = { colors = {"rgba(33ccffee)", "rgba(00ff99ee)"}, angle = 45 },
            inactive_border = "rgba(595959aa)",
        },

        -- Set to true to enable resizing windows by clicking and dragging on borders and gaps
        resize_on_border = false,

        -- Please see https://wiki.hypr.land/Configuring/Advanced-and-Cool/Tearing/ before you turn this on
        allow_tearing = false,

        layout = "dwindle",
    },

    decoration = {
        rounding       = 10,
        rounding_power = 2,

        -- Change transparency of focused and unfocused windows
        active_opacity   = 1.0,
        inactive_opacity = 0.75,

        shadow = {
            enabled      = true,
            range        = 4,
            render_power = 3,
            color        = 0xee1a1a1a,
        },

        blur = {
            enabled  = true,
            size     = 4,
            passes   = 2,
            vibrancy = 0.1696,
        },
    },
})

-- direct_scanout lets a single fullscreen window (a game) bypass normal
-- compositing and go straight to the display - this defaults OFF, so
-- nothing was getting it, fullscreen or not. "2" only applies it to windows
-- tagged content=game via windowrule (see the Rocket League rule below),
-- rather than blanket-enabling it for every fullscreen surface.
hl.config({
    render = {
        direct_scanout = 2,
    },
})

hl.config({
    animations = {
        enabled = true,
    },
})

-- Default curves, see https://wiki.hypr.land/Configuring/Advanced-and-Cool/Animations/
hl.curve("easeOutQuint",   { type = "bezier", points = { {0.23, 1},    {0.32, 1}    } })
hl.curve("easeInOutCubic", { type = "bezier", points = { {0.65, 0.05}, {0.36, 1}    } })
hl.curve("linear",         { type = "bezier", points = { {0, 0},       {1, 1}       } })
hl.curve("almostLinear",   { type = "bezier", points = { {0.5, 0.5},   {0.75, 1}    } })
hl.curve("quick",          { type = "bezier", points = { {0.15, 0},    {0.1, 1}     } })

-- Default animations, see https://wiki.hypr.land/Configuring/Advanced-and-Cool/Animations/
-- NOTE: dwindle:pseudotile was removed upstream (0.55+) - pseudotiling is now
-- controlled purely by the "pseudo" dispatcher bind (mainMod + P below).
hl.animation({ leaf = "global",        enabled = true, speed = 10,   bezier = "default" })
hl.animation({ leaf = "border",        enabled = true, speed = 5.39, bezier = "easeOutQuint" })
hl.animation({ leaf = "windows",       enabled = true, speed = 4.79, bezier = "easeOutQuint" })
hl.animation({ leaf = "windowsIn",     enabled = true, speed = 4.1,  bezier = "easeOutQuint", style = "popin 87%" })
hl.animation({ leaf = "windowsOut",    enabled = true, speed = 1.49, bezier = "linear",       style = "popin 87%" })
hl.animation({ leaf = "fadeIn",        enabled = true, speed = 1.73, bezier = "almostLinear" })
hl.animation({ leaf = "fadeOut",       enabled = true, speed = 1.46, bezier = "almostLinear" })
hl.animation({ leaf = "fade",          enabled = true, speed = 3.03, bezier = "quick" })
hl.animation({ leaf = "layers",        enabled = true, speed = 3.81, bezier = "easeOutQuint" })
hl.animation({ leaf = "layersIn",      enabled = true, speed = 4,    bezier = "easeOutQuint", style = "fade" })
hl.animation({ leaf = "layersOut",     enabled = true, speed = 1.5,  bezier = "linear",       style = "fade" })
hl.animation({ leaf = "fadeLayersIn",  enabled = true, speed = 1.79, bezier = "almostLinear" })
hl.animation({ leaf = "fadeLayersOut", enabled = true, speed = 1.39, bezier = "almostLinear" })
hl.animation({ leaf = "workspaces",    enabled = true, speed = 1.94, bezier = "almostLinear", style = "fade" })
hl.animation({ leaf = "workspacesIn",  enabled = true, speed = 1.21, bezier = "almostLinear", style = "fade" })
hl.animation({ leaf = "workspacesOut", enabled = true, speed = 1.94, bezier = "almostLinear", style = "fade" })
hl.animation({ leaf = "zoomFactor",    enabled = true, speed = 7,    bezier = "quick" })

-- Ref https://wiki.hypr.land/Configuring/Basics/Workspace-Rules/
-- "Smart gaps" / "No gaps when only"
-- uncomment all if you wish to use that.
-- hl.workspace_rule({ workspace = "w[tv1]", gaps_out = 0, gaps_in = 0 })
-- hl.workspace_rule({ workspace = "f[1]",   gaps_out = 0, gaps_in = 0 })
-- hl.window_rule({ match = { float = false, workspace = "w[tv1]" }, border_size = 0, rounding = 0 })
-- hl.window_rule({ match = { float = false, workspace = "f[1]" },   border_size = 0, rounding = 0 })

-- See https://wiki.hypr.land/Configuring/Layouts/Dwindle-Layout/ for more
hl.config({
    dwindle = {
        preserve_split = true, -- You probably want this
    },
})

-- See https://wiki.hypr.land/Configuring/Layouts/Master-Layout/ for more
hl.config({
    master = {
        new_status = "master",
    },
})

-- https://wiki.hypr.land/Configuring/Variables/#misc
hl.config({
    misc = {
        force_default_wallpaper = -1,    -- Set to 0 or 1 to disable the anime mascot wallpapers
        disable_hyprland_logo   = false, -- If true disables the random hyprland logo / anime girl background. :(
    },
})


---------------
---- INPUT ----
---------------

hl.config({
    input = {
        kb_layout  = "us",
        kb_variant = "",
        kb_model   = "",
        kb_options = "",
        kb_rules   = "",

        -- 0 = click-to-focus only, like Windows/KDE. Default (1) changes focus
        -- to whatever's under the cursor just by moving the mouse over it.
        follow_mouse = 0,

        -- Matched to your KDE libinput settings (~/.config/kcminputrc had
        -- PointerAcceleration=-0.400 with a flat accel profile) so it should feel
        -- the same as it did in Plasma - both go through libinput directly.
        sensitivity = -0.4, -- -1.0 - 1.0, 0 means no modification.
        accel_profile = "flat",

        touchpad = {
            natural_scroll = false,
        },
    },
})

-- See https://wiki.hypr.land/Configuring/Advanced-and-Cool/Gestures
hl.gesture({
    fingers   = 3,
    direction = "horizontal",
    action    = "workspace",
})

-- Example per-device config
-- See https://wiki.hypr.land/Configuring/Advanced-and-Cool/Devices/ for more
hl.device({
    name        = "epic-mouse-v1",
    sensitivity = -0.5,
})


---------------------
---- KEYBINDINGS ----
---------------------

local mainMod = "SUPER" -- Sets "Windows" key as main modifier

-- Example binds, see https://wiki.hypr.land/Configuring/Basics/Binds/ for more
hl.bind(mainMod .. " + Q", hl.dsp.exec_cmd(terminal))
hl.bind(mainMod .. " + C", hl.dsp.window.close())
hl.bind(mainMod .. " + SHIFT + E", hl.dsp.exit())
hl.bind(mainMod .. " + E", hl.dsp.exec_cmd(fileManager))
hl.bind(mainMod .. " + V", hl.dsp.window.float())
hl.bind(mainMod .. " + R", hl.dsp.exec_cmd(menu))
hl.bind(mainMod .. " + P", hl.dsp.window.pseudo())    -- dwindle
hl.bind(mainMod .. " + J", hl.dsp.layout("togglesplit"))    -- dwindle - "togglesplit" dispatcher was renamed to a layoutmsg

-- ---- KDE/Windows-muscle-memory binds ----
-- NOTE: default Hyprland used $mainMod+M to exit (log out) the whole session.
-- On Windows/KDE, Super+M minimizes, so that's a landmine for muscle memory -
-- exit is now $mainMod SHIFT+E instead (see above).

-- Alt+Tab cycles windows, like Windows/KDE. Shift+Alt+Tab cycles backwards.
-- NOTE: this uses a helper script, not the native "cyclenext" dispatcher -
-- cyclenext turned out to be hardcoded to only cycle windows on the CURRENT
-- workspace in this Hyprland build, with no config-level way to widen that,
-- which is why plain Alt+Tab looked like it was doing nothing whenever only
-- one window was on your active workspace. See ~/.config/hypr/scripts/alt-tab.sh
hl.bind("ALT + Tab", hl.dsp.exec_cmd("~/.config/hypr/scripts/alt-tab.sh next"))
hl.bind("ALT + SHIFT + Tab", hl.dsp.exec_cmd("~/.config/hypr/scripts/alt-tab.sh prev"))

-- Alt+F4 closes the active window (kept alongside $mainMod+C)
hl.bind("CTRL + Q", hl.dsp.window.close())

-- Super+L locks the screen. Requires hyprlock (not installed yet - see notes below)
hl.bind(mainMod .. " + L", hl.dsp.exec_cmd("hyprlock"))

-- Print / Shift+Print - same keys as KDE's Spectacle, but Spectacle itself
-- can't run under Hyprland (its Wayland backend hard-requires KWin's own
-- screenshot interface - confirmed via its own error message). Using
-- grim+slurp instead, saved to ~/Pictures/Screenshots and copied to the
-- clipboard. See ~/.config/hypr/scripts/screenshot.sh
hl.bind("Print", hl.dsp.exec_cmd("~/.config/hypr/scripts/screenshot.sh full"), { locked = true })
hl.bind("SHIFT + Print", hl.dsp.exec_cmd("~/.config/hypr/scripts/screenshot.sh region"), { locked = true })

-- Switch to the prev/next workspace ON YOUR CURRENT MONITOR ("m-1"/"m+1" -
-- not the same as bare "-1"/"+1", which is raw arithmetic on the workspace
-- ID globally and could jump you onto a different monitor if you ever
-- cycled onto workspace 11, which is pinned to monitor 3 below).
-- Replaces movefocus, which used to live here - Alt+Tab is the reliable
-- window-switcher now (see chat for why directional focus got flaky once
-- everything floats), so plain directional focus wasn't earning its keys.
hl.bind(mainMod .. " + left",  hl.dsp.focus({ workspace = "m-1" }))
hl.bind(mainMod .. " + right", hl.dsp.focus({ workspace = "m+1" }))

-- Move the focused window to the prev/next workspace on your current
-- monitor, and follow it there. Uses a helper script rather than the plain
-- "m-1"/"m+1" selector: going past the LAST existing workspace creates a
-- fresh empty one instead of just wrapping back to the first - Hyprland's
-- selectors can't express "cycle the existing set, but overflow into a new
-- one at the end" in a single dispatch. Going past the FIRST workspace still
-- just wraps normally. Unused empty workspaces clean themselves up once you
-- leave them, so this never piles up clutter. See
-- ~/.config/hypr/scripts/move-to-workspace-cycle.sh
hl.bind(mainMod .. " + SHIFT + left",  hl.dsp.exec_cmd("~/.config/hypr/scripts/move-to-workspace-cycle.sh prev"))
hl.bind(mainMod .. " + SHIFT + right", hl.dsp.exec_cmd("~/.config/hypr/scripts/move-to-workspace-cycle.sh next"))

-- Maximize the focused window (toggle - press again to restore).
hl.bind(mainMod .. " + up", hl.dsp.window.fullscreen({ mode = "maximized" }))

-- Move the focused window to the monitor in that direction (a different
-- thing from moving it to another workspace on the SAME monitor, above).
-- Moved here from Shift+arrows once those got reassigned to workspace-move.
hl.bind(mainMod .. " + CTRL + left",  hl.dsp.window.move({ monitor = "l" }))
hl.bind(mainMod .. " + CTRL + right", hl.dsp.window.move({ monitor = "r" }))
hl.bind(mainMod .. " + CTRL + up",    hl.dsp.window.move({ monitor = "u" }))

-- mainMod+down / mainMod+shift+down are free for now - minimize (which
-- lived here) is on hold. Workspace 11 is still pinned to monitor 3 above
-- if you want to wire minimize back up later; nothing currently sends
-- windows there.

-- Fullscreen the active window (there was no bind for this at all before)
hl.bind(mainMod .. " + F", hl.dsp.window.fullscreen({ mode = "fullscreen" }))

-- Switch workspaces with mainMod + [0-9]
-- Move active window to a workspace with mainMod + SHIFT + [0-9]
for i = 1, 10 do
    local key = i % 10 -- 10 maps to key 0
    hl.bind(mainMod .. " + " .. key,         hl.dsp.focus({ workspace = i }))
    hl.bind(mainMod .. " + SHIFT + " .. key, hl.dsp.window.move({ workspace = i }))
end

-- Example special workspace (scratchpad)
hl.bind(mainMod .. " + S", hl.dsp.workspace.toggle_special("magic"))

-- Super+Shift+S = region screenshot, matching Windows' Snip & Sketch muscle
-- memory. This used to be the default "move window to magic scratchpad"
-- bind - moved that off this key since it was the thing making windows
-- vanish into "magic mode" instead of taking a screenshot.
hl.bind(mainMod .. " + SHIFT + S", hl.dsp.exec_cmd("~/.config/hypr/scripts/screenshot.sh region"), { locked = true })

-- Scroll through existing workspaces with mainMod + scroll
hl.bind(mainMod .. " + mouse_down", hl.dsp.focus({ workspace = "e+1" }))
hl.bind(mainMod .. " + mouse_up",   hl.dsp.focus({ workspace = "e-1" }))

-- Move/resize windows with mainMod + LMB/RMB and dragging
hl.bind(mainMod .. " + mouse:272", hl.dsp.window.drag(),   { mouse = true })
hl.bind(mainMod .. " + mouse:273", hl.dsp.window.resize(), { mouse = true })

-- Laptop multimedia keys for volume and LCD brightness
hl.bind("XF86AudioRaiseVolume",   hl.dsp.exec_cmd("wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+"), { locked = true, repeating = true })
hl.bind("XF86AudioLowerVolume",   hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"),      { locked = true, repeating = true })
hl.bind("XF86AudioMute",          hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"),     { locked = true, repeating = true })
hl.bind("XF86AudioMicMute",       hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"),   { locked = true, repeating = true })
hl.bind("XF86MonBrightnessUp",    hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%+"),                  { locked = true, repeating = true })
hl.bind("XF86MonBrightnessDown",  hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%-"),                  { locked = true, repeating = true })

-- Requires playerctl
hl.bind("XF86AudioNext",  hl.dsp.exec_cmd("playerctl next"),       { locked = true })
hl.bind("XF86AudioPause", hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
hl.bind("XF86AudioPlay",  hl.dsp.exec_cmd("playerctl play-pause"), { locked = true })
hl.bind("XF86AudioPrev",  hl.dsp.exec_cmd("playerctl previous"),   { locked = true })


--------------------------------
---- WINDOWS AND WORKSPACES ----
--------------------------------

-- See https://wiki.hypr.land/Configuring/Basics/Window-Rules/
-- and https://wiki.hypr.land/Configuring/Basics/Workspace-Rules/

-- Float every window by default, KDE/Windows-style, instead of auto-tiling.
-- (You can still tile a specific window manually with mainMod+V if you want
-- one occasionally - this just flips which behavior is the default.)
hl.window_rule({
    name  = "float-by-default",
    match = { class = ".*" },
    float = true,
})

-- Ignore maximize requests from apps. You'll probably like this.
hl.window_rule({
    name  = "suppress-maximize-events",
    match = { class = ".*" },
    suppress_event = "maximize",
})

-- Fix some dragging issues with XWayland
hl.window_rule({
    name  = "xwayland-drag-fix",
    match = {
        class      = "^$",
        title      = "^$",
        xwayland   = true,
        float      = true,
        fullscreen = false,
        pin        = false,
    },
    no_focus = true,
})

--------------------------
--- FLOATING WINDOWS ----
--------------------------

-- Utility / settings dialogs that should always float instead of tiling
hl.window_rule({ name = "float-pavucontrol", match = { class = "^(pavucontrol)$" },              float = true })
hl.window_rule({ name = "float-blueman",     match = { class = "^(blueman-manager)$" },          float = true })
hl.window_rule({ name = "float-nm-editor",   match = { class = "^(nm-connection-editor)$" },     float = true })

-- Purely a background helper (pipes X11 screen-share compatibility) with no
-- real UI - parks it on a hidden workspace so it keeps running but never
-- shows up as a stray black window, in the dock, or in Alt+Tab.
hl.window_rule({
    name  = "hide-xwaylandvideobridge",
    match = { class = "^(xwaylandvideobridge)$" },
    workspace = "special:hidden silent",
    no_focus  = true,
})

-- Rocket League runs through Proton as an XWayland app, and its own
-- exclusive-fullscreen request gets rejected by Hyprland (tested directly -
-- the toggle silently fails, window just shifts position). Workaround: set
-- the game itself to Windowed/Borderless in its own display settings, and
-- force Hyprland's OWN fullscreen state here instead - this sidesteps the
-- broken negotiation entirely. "content = game" is what makes it eligible
-- for direct_scanout's "auto" mode above, so this doesn't lose the low-
-- latency scanout path a real fullscreen window would normally get.
hl.window_rule({
    name  = "rocketleague-game",
    -- Proton derives the X11 WM_CLASS from the Steam app id, even when the
    -- game is launched from Heroic/Epic (umu passes STEAM_COMPAT_APP_ID
    -- through), so this is "steam_app_252950" and never "rocketleague.exe".
    -- The old match silently applied to nothing. See hyprland.conf for the
    -- full writeup.
    match = { class = "^(steam_app_252950|rocketleague\\.exe)$" },
    content    = "game",
    monitor    = "HDMI-A-1",
})

hl.window_rule({ name = "float-polkit",     match = { class = "^(org.kde.polkit-kde-authentication-agent-1)$" }, float = true })
hl.window_rule({ name = "float-portal-gtk", match = { class = "^(xdg-desktop-portal-gtk)$" },                    float = true })

hl.window_rule({
    name  = "float-dolphin-properties",
    match = { class = "^(org.kde.dolphin)$", title = "^(Properties)$" },
    float = true,
})

-- File pickers / save dialogs (title-matched, since these often share the app's class)
hl.window_rule({ name = "float-open-file",     match = { title = "^(Open File)$" },     float = true })
hl.window_rule({ name = "float-save-file",     match = { title = "^(Save File)$" },     float = true })
hl.window_rule({ name = "float-open-folder",   match = { title = "^(Open Folder)$" },   float = true })
hl.window_rule({ name = "float-choose-files",  match = { title = "^(Choose Files)$" },  float = true })

-- Picture-in-picture video stays floating and on top of tiled windows
hl.window_rule({
    name  = "float-pip",
    match = { title = "^(Picture-in-Picture)$" },
    float = true,
    pin   = true,
})

-- Center every floating window when it opens
hl.window_rule({ name = "center-floating", match = { float = true }, center = true })

-- Prevent Unity dropdowns/popups from breaking or closing instantly
hl.window_rule({
    name  = "min-size-select-preset",
    match = { initial_title = "Select Preset..." },
    min_size = { 500, 350 },
})
hl.window_rule({
    name  = "min-size-unity-grid-settings",
    match = { initial_title = "UnityEditor.Snap.GridSettingsWindow" },
    min_size = { 300, 100 },
})
hl.window_rule({
    name  = "min-size-unity-dropdown",
    match = { initial_title = "UnityEngine.InputSystem.Editor.AdvancedDropdownWindow" },
    min_size = { 500, 500 },
})

-- Global fix for XWayland floating popups/menus closing instantly on mouse hover
hl.window_rule({
    name  = "unity-popup-stay-focused",
    match = { class = "Unity", title = "^$" },
    stay_focused = true,
})

-- To float any other app: run `hyprctl clients` while it's open to find its
-- class, then add a new hl.window_rule() with a match.class matching that class, plus float = true

------------------------
---- TRANSPARENCY/BLUR ----
------------------------

-- Panels (dock + top bar) are layer-shell surfaces, not windows - their CSS
-- already sets a translucent background (see ~/.config/nwg-panel/style.css),
-- but decoration:blur only reaches them if a layerrule explicitly says so.
-- Kitty gets its own native background_opacity instead (~/.config/kitty/kitty.conf)
-- since that fades only the background and keeps text sharp; regular windows
-- pick up blur automatically from decoration.blur once they have any alpha.
hl.layer_rule({
    name  = "blur-nwg-panel",
    match = { namespace = "nwg-panel" },
    blur  = true,
})

-- rofi (Super+R launcher) - its style-1.rasi sets a translucent background,
-- but like the panels above, blur only reaches it via this rule.
hl.layer_rule({
    name  = "blur-rofi",
    match = { namespace = "rofi" },
    blur  = true,
})
