
# #######################################################################################
# AUTOGENERATED HYPRLAND CONFIG.
# EDIT THIS CONFIG ACCORDING TO THE WIKI INSTRUCTIONS.
# #######################################################################################

# autogenerated = 1 # remove this line to remove the warning

# This is an example Hyprland config file.
# Refer to the wiki for more information.
# https://wiki.hypr.land/Configuring/

# Please note not all available settings / options are set here.
# For a full list, see the wiki

# You can split this configuration into multiple files
# Create your files separately and then link them to this file like this:
# source = ~/.config/hypr/myColors.conf


################
### MONITORS ###
################

# See https://wiki.hypr.land/Configuring/Monitors/
# Explicit per-monitor refresh rates - "preferred" from EDID often means the
# highest *resolution*, not the highest refresh rate, so DP-3 and HDMI-A-1
# were both silently running at 60Hz despite supporting more.
monitor = DP-1, 3840x2160@60.00, 0x0, 1
monitor = DP-3, 1920x1080@74.97, 3840x0, 1
monitor = HDMI-A-1, 1920x1080@120.00, 5760x0, 1

# Hyprland has no single "primary monitor" concept the way Windows does -
# this is the closest equivalent: puts the cursor on HDMI-A-1 at startup
# instead of wherever it defaults to otherwise, so focus (and therefore
# newly opened windows) starts there instead of on a monitor you have to
# manually drag everything off of first.
cursor {
    default_monitor = HDMI-A-1
}

# Workspace 11 is the "minimized windows" stash (see the mainMod+down bind
# below) - pinned here so restoring a window always lands it back on this
# monitor, regardless of which monitor it was minimized from.
workspace = 11, monitor:HDMI-A-1


###################
### MY PROGRAMS ###
###################

# See https://wiki.hypr.land/Configuring/Keywords/

# Set programs that you use
$terminal = kitty
$fileManager = dolphin
$menu = rofi -show drun -theme ~/.config/rofi/style-1.rasi


#################
### AUTOSTART ###
#################

# Autostart necessary processes (like notifications daemons, status bars, etc.)
# Or execute your favorite apps at launch like this:

# exec-once = $terminal
# exec-once = nm-applet &
# exec-once = waybar & hyprpaper & firefox

# Wallpaper. swww img does NOT reliably wait for swww-daemon's socket on
# this system - it loses that race often enough to show solid black - so
# the actual image-setting is a script that polls until the daemon answers.
exec-once = swww-daemon
exec-once = ~/.config/hypr/scripts/set-wallpaper.sh

# Waybar - superseded by AGS's Bar widget below
# exec-once = waybar

# macOS-style bottom dock (pinned + running apps), see ~/.config/nwg-panel/
# Superseded by AGS's AppBar widget below
# exec-once = nwg-panel

# Bar, AppBar, DesktopWidget - see ~/.config/ags/
exec-once = ags run

# Auto-raises whatever gets focused (fixes dock/taskbar clicks not bringing
# the window to front). See ~/.config/hypr/scripts/auto-raise.sh
exec-once = ~/.config/hypr/scripts/auto-raise.sh

# Marks HDMI-A-1 as the XRandR "primary" output for XWayland clients.
# Hyprland sets no primary at all, so Proton games that ask X for "the"
# display fall back to whatever sits at origin 0x0 - DP-1, the 4K. This is
# what was actually sending Rocket League to the wrong monitor; the
# windowrule below could only move it after the fact.
exec-once = ~/.config/hypr/scripts/xwayland-primary.sh HDMI-A-1

# KWallet's secret-service bridge (what VSCode/Docker/etc. use for stored
# credentials). SDDM's PAM hook already starts it at login as
# "ksecretd --pam-login ..." to auto-unlock it with your login password,
# but under Hyprland that flow never finishes - confirmed directly: killing
# that instance and starting ksecretd plainly makes it correctly claim
# org.freedesktop.secrets on the bus, where the PAM-launched one never did.
# Trade-off: since this isn't the PAM auto-unlock flow, the wallet may
# prompt you for its password the first time something asks for a secret
# each session, rather than being silently unlocked like it was on Plasma.
exec-once = ksecretd


#############################
### ENVIRONMENT VARIABLES ###
#############################

# See https://wiki.hypr.land/Configuring/Environment-variables/

env = XCURSOR_SIZE,24
env = HYPRCURSOR_SIZE,24

# Qt apps (Dolphin, etc.) pick their theme by checking XDG_CURRENT_DESKTOP
# for "KDE" - Hyprland reports itself instead, so this has to be set manually.
#
# This was "kde6" for a while, then qt6ct, because kde6 appeared to make
# Dolphin render unstyled/light at random. The real cause turned out to be
# much simpler: "kde6" is not a valid platform theme key. Qt silently accepts
# an unknown value and loads NO platform theme at all, which is
# indistinguishable from setting nothing - so the "flakiness" was just Qt
# falling back, consistently. The key KDEPlasmaPlatformTheme6.so registers is
# plain "kde".
#
# qt6ct was not wrong about the palette. Measured under every candidate, the
# QPalette is byte-identical (Kvantum supplies it, and it was always dark).
# The value that differs is QStyleHints::colorScheme():
#
#     qt6ct -> Unknown     kde6 -> Unknown     <unset> -> Unknown
#     kde   -> Dark        xdgdesktopportal -> Dark
#
# KF6 apps consult colorScheme() on top of the palette, which is why Dolphin's
# file list drew alternating rows white-on-dark and dark-on-light against each
# other even though Base was #404552. "kde" reports Dark and reads kdeglobals
# (already a correct dark scheme), and Dolphin then comes up uniformly dark.
#
# "xdgdesktopportal" also reports Dark, sourced from the appearance portal, so
# it would follow the same gsettings color-scheme key as the GTK side - one
# lever for both toolkits. The trade-off is losing KDE-specific integration
# (file dialogs, kdeglobals colours), so "kde" for now.
env = QT_QPA_PLATFORMTHEME,kde

# QT_QPA_PLATFORMTHEME above only covers palette/colors - the actual widget
# *style* (Kvantum, set as your widgetStyle in kdeglobals) needs its own
# override or Qt falls back to the generic Fusion style regardless.
# "kvantum-dark" specifically (not just "kvantum") - checked the actual
# plugin binary and it registers both as distinct style keys; kdeglobals
# has widgetStyle=kvantum-dark, so this matches what's really configured
# instead of falling back to whatever Kvantum's own separate config picks.
env = QT_STYLE_OVERRIDE,kvantum-dark

# The env= line above only sets QT_STYLE_OVERRIDE inside Hyprland's own
# process, so anything Hyprland forks directly (keybinds, exec-once, rofi)
# inherits it fine. But Hyprland's startup only re-exports a hardcoded set
# of vars (DISPLAY, WAYLAND_DISPLAY, HYPRLAND_INSTANCE_SIGNATURE,
# XDG_CURRENT_DESKTOP, QT_QPA_PLATFORMTHEME, PATH, XDG_DATA_DIRS) to the
# systemd/dbus activation environment - QT_STYLE_OVERRIDE isn't in that
# list and can't be added via config, so anything dbus-activated (like the
# xdg-desktop-portal-hyprland screen-share picker) never sees it unless we
# push it there ourselves.
exec-once = uwsm finalize QT_STYLE_OVERRIDE


###################
### PERMISSIONS ###
###################

# See https://wiki.hypr.land/Configuring/Permissions/
# Please note permission changes here require a Hyprland restart and are not applied on-the-fly
# for security reasons

# ecosystem {
#   enforce_permissions = 1
# }

# permission = /usr/(bin|local/bin)/grim, screencopy, allow
# permission = /usr/(lib|libexec|lib64)/xdg-desktop-portal-hyprland, screencopy, allow
# permission = /usr/(bin|local/bin)/hyprpm, plugin, allow


#####################
### LOOK AND FEEL ###
#####################

# Refer to https://wiki.hypr.land/Configuring/Variables/

# https://wiki.hypr.land/Configuring/Variables/#general
general {
    gaps_in = 5
    gaps_out = 20

    border_size = 2

    # https://wiki.hypr.land/Configuring/Variables/#variable-types for info about colors
    col.active_border = rgba(33ccffee) rgba(00ff99ee) 45deg
    col.inactive_border = rgba(595959aa)

    # Set to true enable resizing windows by clicking and dragging on borders and gaps
    resize_on_border = true

    # Please see https://wiki.hypr.land/Configuring/Tearing/ before you turn this on
    allow_tearing = true

    layout = dwindle
}

# https://wiki.hypr.land/Configuring/Variables/#decoration
decoration {
    rounding = 10
    rounding_power = 2

    # Change transparency of focused and unfocused windows
    active_opacity = 1.0
    inactive_opacity = 0.75

    shadow {
        enabled = true
        range = 4
        render_power = 3
        color = rgba(1a1a1aee)
    }

    # https://wiki.hypr.land/Configuring/Variables/#blur
    blur {
        enabled = true
        size = 4
        passes = 2

        vibrancy = 0.1696
	new_optimizations = true
        # GtkPopover content (ags menus/popups) renders as an xdg_popup, not
        # a layer-shell surface, so the blur-top-bar layerrule below never
        # reaches it - this is the separate switch that does. Without it a
        # translucent popover (see scss/_bar.scss) looks translucent-but-
        # sharp instead of matching the bar's blurred pills.
        popups = true
    }
}

# direct_scanout lets a single fullscreen window (a game) bypass normal
# compositing and go straight to the display - this defaults OFF, so
# nothing was getting it, fullscreen or not. "2" only applies it to windows
# tagged content=game via windowrule (see the Rocket League rule below),
# rather than blanket-enabling it for every fullscreen surface.
render {
    direct_scanout = 2
}

# https://wiki.hypr.land/Configuring/Variables/#animations
animations {
    enabled = yes, please :)

    # Default curves, see https://wiki.hypr.land/Configuring/Animations/#curves
    #        NAME,           X0,   Y0,   X1,   Y1
    bezier = easeOutQuint,   0.23, 1,    0.32, 1
    bezier = easeInOutCubic, 0.65, 0.05, 0.36, 1
    bezier = linear,         0,    0,    1,    1
    bezier = almostLinear,   0.5,  0.5,  0.75, 1
    bezier = quick,          0.15, 0,    0.1,  1

    # Default animations, see https://wiki.hypr.land/Configuring/Animations/
    #           NAME,          ONOFF, SPEED, CURVE,        [STYLE]
    animation = global,        1,     10,    default
    animation = border,        1,     5.39,  easeOutQuint
    animation = windows,       1,     4.79,  easeOutQuint
    animation = windowsIn,     1,     4.1,   easeOutQuint, popin 87%
    animation = windowsOut,    1,     1.49,  linear,       popin 87%
    animation = fadeIn,        1,     1.73,  almostLinear
    animation = fadeOut,       1,     1.46,  almostLinear
    animation = fade,          1,     3.03,  quick
    animation = layers,        1,     3.81,  easeOutQuint
    animation = layersIn,      1,     4,     easeOutQuint, fade
    animation = layersOut,     1,     1.5,   linear,       fade
    animation = fadeLayersIn,  1,     1.79,  almostLinear
    animation = fadeLayersOut, 1,     1.39,  almostLinear
    animation = workspaces,    1,     1.94,  almostLinear, fade
    animation = workspacesIn,  1,     1.21,  almostLinear, fade
    animation = workspacesOut, 1,     1.94,  almostLinear, fade
    animation = zoomFactor,    1,     7,     quick
}

# Ref https://wiki.hypr.land/Configuring/Workspace-Rules/
# "Smart gaps" / "No gaps when only"
# uncomment all if you wish to use that.
# workspace = w[tv1], gapsout:0, gapsin:0
# workspace = f[1], gapsout:0, gapsin:0
# windowrule = bordersize 0, floating:0, onworkspace:w[tv1]
# windowrule = rounding 0, floating:0, onworkspace:w[tv1]
# windowrule = bordersize 0, floating:0, onworkspace:f[1]
# windowrule = rounding 0, floating:0, onworkspace:f[1]

# See https://wiki.hypr.land/Configuring/Dwindle-Layout/ for more
# NOTE: dwindle:pseudotile was removed upstream (0.55+) - pseudotiling is now
# controlled purely by the "pseudo" dispatcher bind (mainMod + P below).
dwindle {
    preserve_split = true # You probably want this
}

# See https://wiki.hypr.land/Configuring/Master-Layout/ for more
master {
    new_status = master
}

# https://wiki.hypr.land/Configuring/Variables/#misc
misc {
    force_default_wallpaper = -1 # Set to 0 or 1 to disable the anime mascot wallpapers
    disable_hyprland_logo = false # If true disables the random hyprland logo / anime girl background. :(
}


#############
### INPUT ###
#############

# https://wiki.hypr.land/Configuring/Variables/#input
input {
    kb_layout = us
    kb_variant =
    kb_model =
    kb_options =
    kb_rules =

    # 0 = click-to-focus only, like Windows/KDE. Default (1) changes focus
    # to whatever's under the cursor just by moving the mouse over it.
    follow_mouse = 0

    # Matched to your KDE libinput settings (~/.config/kcminputrc had
    # PointerAcceleration=-0.400 with a flat accel profile) so it should feel
    # the same as it did in Plasma - both go through libinput directly.
    sensitivity = -0.4 # -1.0 - 1.0, 0 means no modification.
    accel_profile = flat

    touchpad {
        natural_scroll = false
    }
}

# See https://wiki.hypr.land/Configuring/Gestures
gesture = 3, horizontal, workspace

# Example per-device config
# See https://wiki.hypr.land/Configuring/Keywords/#per-device-input-configs for more
device {
    name = epic-mouse-v1
    sensitivity = -0.5
}


###################
### KEYBINDINGS ###
###################

# See https://wiki.hypr.land/Configuring/Keywords/
$mainMod = SUPER # Sets "Windows" key as main modifier

# Example binds, see https://wiki.hypr.land/Configuring/Binds/ for more
bind = $mainMod, Q, exec, $terminal
bind = $mainMod, C, killactive,
bind = $mainMod SHIFT, E, exit,
bind = $mainMod, E, exec, $fileManager
bind = $mainMod, V, togglefloating,
# bindr (release-triggered) on the bare mod key: fires only if you tap and
# release Super without pressing another bound key in between - Hyprland
# suppresses it if a combo bind (e.g. mainMod+Q) already consumed the hold.
bindr = $mainMod, SUPER_L, exec, $menu
bind = $mainMod, P, pseudo, # dwindle
bind = $mainMod, J, layoutmsg, togglesplit # dwindle - "togglesplit" dispatcher was renamed to a layoutmsg

input {
    kb_layout = us
    kb_options = compose:ralt
}


# ---- KDE/Windows-muscle-memory binds ----
# NOTE: default Hyprland used $mainMod+M to exit (log out) the whole session.
# On Windows/KDE, Super+M minimizes, so that's a landmine for muscle memory -
# exit is now $mainMod SHIFT+E instead (see above).

# Alt+Tab cycles windows, like Windows/KDE. Shift+Alt+Tab cycles backwards.
# NOTE: this uses a helper script, not the native "cyclenext" dispatcher -
# cyclenext turned out to be hardcoded to only cycle windows on the CURRENT
# workspace in this Hyprland build, with no config-level way to widen that,
# which is why plain Alt+Tab looked like it was doing nothing whenever only
# one window was on your active workspace. See ~/.config/hypr/scripts/alt-tab.sh
bind = ALT, Tab, exec, ~/.config/hypr/scripts/alt-tab.sh next
bind = ALT SHIFT, Tab, exec, ~/.config/hypr/scripts/alt-tab.sh prev

# Alt+F4 closes the active window (kept alongside $mainMod+C)
bind = CTRL, Q, killactive,

# Super+L locks the screen. Requires hyprlock (not installed yet - see notes below)
bind = $mainMod, L, exec, hyprlock

# Print / Shift+Print - same keys as KDE's Spectacle, but Spectacle itself
# can't run under Hyprland (its Wayland backend hard-requires KWin's own
# screenshot interface - confirmed via its own error message). Using
# grim+slurp instead, saved to ~/Pictures/Screenshots and copied to the
# clipboard. See ~/.config/hypr/scripts/screenshot.sh
bindl = , Print, exec, ~/.config/hypr/scripts/screenshot.sh full
bindl = SHIFT, Print, exec, ~/.config/hypr/scripts/screenshot.sh region

# Switch to the prev/next workspace ON YOUR CURRENT MONITOR ("m-1"/"m+1" -
# not the same as bare "-1"/"+1", which is raw arithmetic on the workspace
# ID globally and could jump you onto a different monitor if you ever
# cycled onto workspace 11, which is pinned to monitor 3 below).
# Replaces movefocus, which used to live here - Alt+Tab is the reliable
# window-switcher now (see chat for why directional focus got flaky once
# everything floats), so plain directional focus wasn't earning its keys.
bind = $mainMod, left, workspace, m-1
bind = $mainMod, right, workspace, m+1

# Move the focused window to the prev/next workspace on your current
# monitor, and follow it there. Uses a helper script rather than the plain
# "m-1"/"m+1" selector: going past the LAST existing workspace creates a
# fresh empty one instead of just wrapping back to the first - Hyprland's
# selectors can't express "cycle the existing set, but overflow into a new
# one at the end" in a single dispatch. Going past the FIRST workspace still
# just wraps normally. Unused empty workspaces clean themselves up once you
# leave them, so this never piles up clutter. See
# ~/.config/hypr/scripts/move-to-workspace-cycle.sh
bind = $mainMod SHIFT, left, exec, ~/.config/hypr/scripts/move-to-workspace-cycle.sh prev
bind = $mainMod SHIFT, right, exec, ~/.config/hypr/scripts/move-to-workspace-cycle.sh next

# Maximize the focused window (toggle - press again to restore).
bind = $mainMod, up, fullscreen, 1

# Move the focused window to the monitor in that direction (a different
# thing from moving it to another workspace on the SAME monitor, above).
# Moved here from Shift+arrows once those got reassigned to workspace-move.
bind = $mainMod CTRL, left, movewindow, mon:l
bind = $mainMod CTRL, right, movewindow, mon:r
bind = $mainMod CTRL, up, movewindow, mon:u

# mainMod+down / mainMod+shift+down are free for now - minimize (which
# lived here) is on hold. Workspace 11 is still pinned to monitor 3 below
# if you want to wire minimize back up later; nothing currently sends
# windows there.

# Fullscreen the active window (there was no bind for this at all before)
bind = $mainMod, F, fullscreen, 0

# Switch workspaces with mainMod + [0-9]
bind = $mainMod, 1, workspace, 1
bind = $mainMod, 2, workspace, 2
bind = $mainMod, 3, workspace, 3
bind = $mainMod, 4, workspace, 4
bind = $mainMod, 5, workspace, 5
bind = $mainMod, 6, workspace, 6
bind = $mainMod, 7, workspace, 7
bind = $mainMod, 8, workspace, 8
bind = $mainMod, 9, workspace, 9
bind = $mainMod, 0, workspace, 10

# Move active window to a workspace with mainMod + SHIFT + [0-9]
bind = $mainMod SHIFT, 1, movetoworkspace, 1
bind = $mainMod SHIFT, 2, movetoworkspace, 2
bind = $mainMod SHIFT, 3, movetoworkspace, 3
bind = $mainMod SHIFT, 4, movetoworkspace, 4
bind = $mainMod SHIFT, 5, movetoworkspace, 5
bind = $mainMod SHIFT, 6, movetoworkspace, 6
bind = $mainMod SHIFT, 7, movetoworkspace, 7
bind = $mainMod SHIFT, 8, movetoworkspace, 8
bind = $mainMod SHIFT, 9, movetoworkspace, 9
bind = $mainMod SHIFT, 0, movetoworkspace, 10

# Example special workspace (scratchpad)
bind = $mainMod, S, togglespecialworkspace, magic

# Super+Shift+S = region screenshot, matching Windows' Snip & Sketch muscle
# memory. This used to be the default "move window to magic scratchpad"
# bind - moved that off this key since it was the thing making windows
# vanish into "magic mode" instead of taking a screenshot.
bindl = $mainMod SHIFT, S, exec, ~/.config/hypr/scripts/screenshot.sh region

# Scroll through existing workspaces with mainMod + scroll
bind = $mainMod, mouse_down, workspace, e+1
bind = $mainMod, mouse_up, workspace, e-1

# Move/resize windows with mainMod + LMB/RMB and dragging
bindm = $mainMod, mouse:272, movewindow
bindm = $mainMod, mouse:273, resizewindow

# Laptop multimedia keys for volume and LCD brightness
bindel = ,XF86AudioRaiseVolume, exec, wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindel = ,XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindel = ,XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindel = ,XF86AudioMicMute, exec, wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindel = ,XF86MonBrightnessUp, exec, brightnessctl -e4 -n2 set 5%+
bindel = ,XF86MonBrightnessDown, exec, brightnessctl -e4 -n2 set 5%-

# Requires playerctl
bindl = , XF86AudioNext, exec, playerctl next
bindl = , XF86AudioPause, exec, playerctl play-pause
bindl = , XF86AudioPlay, exec, playerctl play-pause
bindl = , XF86AudioPrev, exec, playerctl previous

##############################
### WINDOWS AND WORKSPACES ###
##############################

# See https://wiki.hypr.land/Configuring/Window-Rules/ for more
# See https://wiki.hypr.land/Configuring/Workspace-Rules/ for workspace rules
#
# NOTE: as of Hyprland 0.55+, the old one-line
#   windowrule = <effect>, class:<regex>, title:<regex>
# syntax was replaced with a block syntax: a required unique "name", a
# "match { }" block for the selectors, and effect keys at the top level.

# Float every window by default, KDE/Windows-style, instead of auto-tiling.
# (You can still tile a specific window manually with mainMod+V if you want
# one occasionally - this just flips which behavior is the default.)
windowrule {
    name = float-by-default
    match {
        class = .*
    }
    float = 1
}

# Ignore maximize requests from apps. You'll probably like this.
windowrule {
    name = suppress-maximize-events
    match {
        class = .*
    }
    suppress_event = maximize
}

# Fix some dragging issues with XWayland
windowrule {
    name = xwayland-drag-fix
    match {
        class = ^$
        title = ^$
        xwayland = 1
        float = 1
        fullscreen = 0
        pin = 0
    }
    no_focus = 1
}

########################
### FLOATING WINDOWS ###
########################

# Utility / settings dialogs that should always float instead of tiling
windowrule {
    name = float-pavucontrol
    match {
        class = ^(pavucontrol)$
    }
    float = 1
}

windowrule {
    name = float-blueman
    match {
        class = ^(blueman-manager)$
    }
    float = 1
}

windowrule {
    name = float-nm-editor
    match {
        class = ^(nm-connection-editor)$
    }
    float = 1
}

# Purely a background helper (pipes X11 screen-share compatibility) with no
# real UI - parks it on a hidden workspace so it keeps running but never
# shows up as a stray black window, in the dock, or in Alt+Tab.
windowrule {
    name = hide-xwaylandvideobridge
    match {
        class = ^(xwaylandvideobridge)$
    }
    workspace = special:hidden silent
    no_focus = 1
}

# Rocket League runs through Proton as an XWayland app. Proton sets the X11
# WM_CLASS from the Steam app id, NOT from the executable name - and it does
# so even when the game is launched from Heroic/Epic, because umu passes
# STEAM_COMPAT_APP_ID through. So the class is "steam_app_252950", and the
# old ^(rocketleague.exe)$ match here never matched anything: no content tag,
# no monitor pin, nothing. Verified against a live window.
#
# Correcting the class is what finally makes "content = game" stick, which is
# the gate for direct_scanout = 2 above - without the tag the monitor reports
# directScanoutBlockedBy: content type and the game gets composited normally.
#
# Note there is no forced fullscreen here any more. The client's own request
# is honoured fine (a running window reports fullscreenClient: 2), so the old
# claim that Hyprland rejected it was a symptom of this rule never applying.
# The monitor pin stays as a backstop to the XRandR primary fix above.
windowrule {
    name = rocketleague-game
    match {
        class = ^(steam_app_252950|rocketleague\.exe)$
    }
    content = game
    monitor = HDMI-A-1
    # Tearing is opt-in per window on top of general:allow_tearing above.
    # Only worth it with the in-game framerate cap raised above 120 - a torn
    # frame can only help if a new one finishes mid-scanout.
    immediate = 1
}

windowrule {
    name = float-polkit
    match {
        class = ^(org.kde.polkit-kde-authentication-agent-1)$
    }
    float = 1
}

windowrule {
    name = float-portal-gtk
    match {
        class = ^(xdg-desktop-portal-gtk)$
    }
    float = 1
}

windowrule {
    name = float-dolphin-properties
    match {
        class = ^(org.kde.dolphin)$
        title = ^(Properties)$
    }
    float = 1
}

# File pickers / save dialogs (title-matched, since these often share the app's class)
windowrule {
    name = float-open-file
    match {
        title = ^(Open File)$
    }
    float = 1
}

windowrule {
    name = float-save-file
    match {
        title = ^(Save File)$
    }
    float = 1
}

windowrule {
    name = float-open-folder
    match {
        title = ^(Open Folder)$
    }
    float = 1
}

windowrule {
    name = float-choose-files
    match {
        title = ^(Choose Files)$
    }
    float = 1
}

# Picture-in-picture video stays floating and on top of tiled windows
windowrule {
    name = float-pip
    match {
        title = ^(Picture-in-Picture)$
    }
    float = 1
    pin = 1
}

# Center every floating window when it opens
windowrule {
    name = center-floating
    match {
        float = 1
    }
    center = 1
}

# Unity Editor window rules - see ~/.config/hypr/UnityFix.conf
source = ~/.config/hypr/UnityFix.conf

# To float any other app: run `hyprctl clients` while it's open to find its
# class, then add a new windowrule block matching that class, with float = 1

######################
### TRANSPARENCY/BLUR ###
######################

# Panels (dock + top bar) are layer-shell surfaces, not windows - their CSS
# already sets a translucent background (see ~/.config/nwg-panel/style.css),
# but decoration:blur only reaches them if a layerrule explicitly says so.
# Kitty gets its own native background_opacity instead (~/.config/kitty/kitty.conf)
# since that fades only the background and keeps text sharp; regular windows
# pick up blur automatically from decoration.blur once they have any alpha.
layerrule {
    name = blur-nwg-panel
    match {
        namespace = nwg-panel
    }
    blur = 1
}

# rofi (tap-Super launcher) - its style-1.rasi sets a translucent background,
# but like the panels above, blur only reaches it via this rule.
layerrule {
    name = blur-rofi
    match {
        namespace = rofi
    }
    blur = 1
}

# The ags surfaces (see ~/.config/ags/). Each window sets its own namespace=
# rather than sharing gtk4-layer-shell's default, so they can be matched
# individually here. Their translucency comes from $bg-opacity in
# ~/.config/ags/scss/_variables.scss.
layerrule {
    name = blur-top-bar
    match {
        namespace = top-bar
    }
    blur = 1
    # Hyprland blurs everything under the surface that isn't fully opaque, so
    # without a threshold the whole full-width strip frosts over, empty gaps
    # included. This confines blur to the pills, which sit at $bg-opacity.
    # Note the key is snake_case here - the old `layerrule = ignorealpha 0.5,ns`
    # spelling is not accepted inside a layerrule block.
    ignore_alpha = 0.5
}

layerrule {
    name = blur-app-bar
    match {
        namespace = app-bar
    }
    blur = 1
    ignore_alpha = 0.5
}

# Notification toasts from ags (widget/Notifications/). Same treatment as the
# other ags surfaces - the cards sit at $bg-opacity and the gaps between them
# are fully transparent, so ignore_alpha keeps blur on the cards only.
layerrule {
    name = blur-notifications
    match {
        namespace = notifications
    }
    blur = 1
    ignore_alpha = 0.5
}

layerrule {
    name = blur-desktop-widget
    match {
        namespace = desktop-widget
    }
    blur = 1
    ignore_alpha = 0.5
}
source = ~/.config/themes/current/hyprland.conf
